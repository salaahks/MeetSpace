# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=meetspace
POSTGRES_USER=meetspace
POSTGRES_PASSWORD=change-me

# --- Azure AD / Microsoft Entra ID ---
# Backend app registration (Microsoft Graph: User.ReadWrite.All, application permission)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me
AZURE_TENANT_DOMAIN=your-tenant.onmicrosoft.com

# Frontend SPA app registration (redirect URI: http://localhost:3000)
MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: helpdesk URL used to report broken equipment (defaults to e-mail)
SUPPORT_TICKET_URL=
